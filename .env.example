# LeadLinked-CTQ Environment Variables

# The deployed Google Apps Script Web App URL ending in /exec
APPS_SCRIPT_WEB_APP_URL=https://script.google.com/macros/s/YOUR_APPS_SCRIPT_ID/exec

# The secret API token configured inside your Google Apps Script script properties
APPS_SCRIPT_API_SECRET=your_secure_api_secret_key_here
